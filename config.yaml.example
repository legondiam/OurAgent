oauth:
  notion:
    client_id: "${NOTION_CLIENT_ID}"
    client_secret: "${NOTION_CLIENT_SECRET}"
    redirect_url: "http://localhost:8080/api/v1/oauth/notion/callback"

server:
  port: 8080

mysql:
  dsn: "${MYSQL_DSN}"

qdrant:
  url: "http://localhost:6333"
  collection: "our_agent_chunks"

minio:
  endpoint: "localhost:9000"
  access_key: "${MINIO_ACCESS_KEY}"
  secret_key: "${MINIO_SECRET_KEY}"
  bucket: "our-agent-documents"
  use_ssl: false

llm:
  base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
  api_key: "${OPENAI_API_KEY}"
  chat_model: "qwen3.6-plus"
  embedding_model: "text-embedding-v4"

rag:
  chunk_size: 1000
  chunk_overlap: 200
  top_k: 5
  score_threshold: 0.3
  max_context_tokens: 6000
  strict_mode: true
  query_rewrite_enabled: true
  query_rewrite_max_queries: 3
  query_rewrite_include_original: true
  query_rewrite_model_temperature: 0.1
  query_rewrite_hyde_enabled: false
  query_rewrite_step_back_enabled: false
  hybrid_enabled: true
  bm25_enabled: true
  bm25_top_k: 5
  rrf_k: 60

rerank:
  enabled: true
  provider: "dashscope"
  base_url: "https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank"
  api_key: "${OPENAI_API_KEY}"
  model: "qwen3-vl-rerank"
  candidate_limit: 20
  top_n: 8
  timeout_seconds: 60

jwt:
  secret: "${JWT_SECRET}"
  expires_hours: 168

search:
  bluge_dir: "storage/bluge"

rabbitmq:
  enabled: true
  url: "${RABBITMQ_URL}"
  exchange: "ouragent.tasks"
  index_queue: "ouragent.document.index"
  delete_queue: "ouragent.document.delete.cleanup"
  source_sync_queue: "ouragent.source.sync"
  conversation_compact_queue: "ouragent.conversation.compact"
  memory_consolidate_queue: "ouragent.memory.consolidate"
  memory_index_queue: "ouragent.memory.index"
  memory_delete_queue: "ouragent.memory.delete"
  retry_delay_seconds: 30
  max_retries: 5
  index_lease_seconds: 1800
  index_workers: 2
  delete_workers: 2
  source_sync_workers: 1
  conversation_compact_workers: 1
  memory_consolidate_workers: 1
  memory_index_workers: 1
  memory_delete_workers: 1
  prefetch_count: 1

source_sync:
  scheduler_interval_seconds: 60
  lease_seconds: 1800
  schedule_batch_size: 100
  delete_after_missing_syncs: 2

agent_memory:
  short_term_enabled: true
  summary_trigger_tokens: 4000
  context_hard_limit_tokens: 6000
  keep_recent_tokens: 2000
  summary_target_tokens: 1000
  summary_timeout_seconds: 120
  compaction_lease_seconds: 180
  conversation_processing_lease_seconds: 180
  conversation_ttl_hours: 168

long_term_memory:
  enabled: false
  collection: "our_agent_memories"
  directive_enabled: true
  consolidation_enabled: true
  worthiness_gate_enabled: true
  semantic_recall_enabled: true
  semantic_top_k: 12
  final_top_k: 6
  similarity_threshold: 0.70
  max_context_tokens: 1200
  retrieval_timeout_seconds: 3
  directive_timeout_seconds: 30
  consolidation_timeout_seconds: 120
  candidate_expire_hours: 720
  preference_ttl_hours: 4320
  role_ttl_hours: 4320
  terminology_ttl_hours: 4320
  business_object_ttl_hours: 2160
  project_context_ttl_hours: 2160
  auto_promote_min_conversations: 2
  consolidation_idle_seconds: 300
  consolidation_max_signals: 10
  consolidation_max_input_tokens: 4000
  max_candidates_per_batch: 5
  task_lease_seconds: 180
  scheduler_interval_seconds: 30
  scheduler_batch_size: 100

web_search:
  enabled: true
  fallback_only: true
  provider: "dashscope"
  endpoint: "https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation"
  api_key: "${OPENAI_API_KEY}"
  model: "qwen3.6-flash"
  timeout_seconds: 60
  enable_source: true
  disclaimer: "Current knowledge base has insufficient information. The following answer is generated from web search results and is for reference only."
